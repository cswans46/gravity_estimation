# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
# Ignore large data files
*.zip
*.csv
*.xlsx
*.xls
*.gdx
# Image and document files
*.png
*.pdf
*.docx
*.md
!README.md
!**/README.md
!**/docs/*.md
*.dta
# Superfluous .tex files
*.aux
*.log
*.out
*.toc
*.fls
*.synctex.gz
*.fdb_latexmk
# Other files
*.json

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
*.history
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
db/csvs_test_examples/
# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

#Ignore SVG image in documentation
doc/*/*.svg

# PyBuilder
target/

# IPython Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# dotenv
.env

# virtualenv
venv/
ENV/

# Spyder project settings
.spyderproject

# Rope project settings
.ropeproject

# PyCharm settings
.idea

# Don't track example run CSV results
examples/*/results/*.csv
examples/*/*/results/*.csv
examples/*/*/*/results/*.csv
examples/*/*/*/*/results/*.csv
examples/*/*/*/*/*/results/*.csv

# Don't track pass-through inputs directory in multi-stage runs
examples/*/*/pass_through_inputs/

# Don't track inputs or outputs in the scenarios folder
scenarios/

# Ignore node_modules in the UI folder
ui/node_modules

# Mac stuff
__MACOSX
**/.DS_Store

# Ignore db files to avoid accidentally committing large files
**/*.db
**/*.db-shm
**/*.db-wal

# Pipeline outputs
cai_2023/results/
cai_2023/data/
*.npy

# Shipped concordance tables
!cai_2023/gravity_irio/data/*.csv
!cai_2023/tests/fixtures/*.csv

# Large geography inputs (keep locally)
*.shp
*.shx
lpr_*.zip
!cai_2023/docs/*.csv
cai_2023/data/
cai_2023/ODBus_v1/
